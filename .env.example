# Copy to `.env` and fill in. Never commit the real file.
#
# The deploy runbook (docs/DEPLOYMENT.md) walks through these in order, and
# `php bin/doctor.php` verifies the result.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# production | staging | local | testing
# Anything other than production permits APP_DEBUG=true. Production does not: the
# application refuses to boot with debug on, because debug output prints stack traces,
# SQL and filesystem paths to the visitor.
APP_ENV=production
APP_DEBUG=false

# Secret used for signing. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# An empty value is accepted today, but set one before exposing the site.
APP_KEY=

# Absolute site URL, no trailing slash. Used for canonical URLs and generated links.
APP_URL=https://example.com

# Displayed to operators in logs; use the site's real zone.
APP_TIMEZONE=UTC

# Leave empty to derive from the project root. Set explicitly only when the code lives
# somewhere the autoloader cannot infer.
APP_BASE_PATH=

# Writable directory for cache, logs, locks and generated artifacts.
# Empty means <project>/storage.
STORAGE_PATH=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# InnoDB is required, not preferred: the schema uses foreign keys and row transactions.
# A host defaulting to MyISAM accepts the migrations and then silently ignores both.
# `php bin/doctor.php` checks the engine of every table.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Idle session lifetime in minutes.
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# emergency | alert | critical | error | warning | notice | info | debug
# `debug` in production fills a shared host's disk quickly.
LOG_LEVEL=warning

# Empty means <storage>/logs.
LOG_PATH=

# ---------------------------------------------------------------------------
# Outgoing mail (notifications)
# ---------------------------------------------------------------------------

# Must be a mailbox on a domain this host may send for, or notifications are filed as
# spam and the domain's reputation suffers.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ---------------------------------------------------------------------------
# WordPress migration (only needed while cutting over)
# ---------------------------------------------------------------------------

# Empty means "the platform database, using the prefix below".
MIGRATION_SOURCE_DSN=
MIGRATION_SOURCE_USERNAME=
MIGRATION_SOURCE_PASSWORD=
MIGRATION_SOURCE_PREFIX=wp_

# Where the old site's uploads live on this server. Media is only imported when the file
# is present here; a media row with no file renders a broken image forever.
MIGRATION_UPLOADS_PATH=
